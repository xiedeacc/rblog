{
  "name": "rblog-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 5173",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "gen:api": "openapi-typescript http://127.0.0.1:8080/api/admin/openapi.json -o src/api/schema.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.2",
    "@lexical/code": "^0.21.0",
    "@lexical/link": "^0.21.0",
    "@lexical/list": "^0.21.0",
    "@lexical/markdown": "^0.21.0",
    "@lexical/react": "^0.21.0",
    "@lexical/rich-text": "^0.21.0",
    "@lexical/selection": "^0.21.0",
    "@lexical/utils": "^0.21.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "^1.97.0",
    "antd": "^5.22.5",
    "dayjs": "^1.11.13",
    "katex": "^0.16.47",
    "lexical": "^0.21.0",
    "marked": "^18.0.3",
    "mermaid": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tanstack/router-devtools": "^1.97.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.4.4",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
